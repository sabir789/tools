from burp import IBurpExtender, ITab, IContextMenuFactory, IMessageEditorController
import java.lang
from javax.swing import JPanel, JCheckBox, JTextField, JLabel, JTable, JScrollPane, BorderFactory, SwingUtilities, JMenuItem, JButton, JSplitPane, JTabbedPane, JOptionPane
from javax.swing.table import DefaultTableModel
