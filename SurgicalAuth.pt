from java.io import PrintWriter

class MessageController(IMessageEditorController):
    def __init__(self, helpers):
        self._http_service = None
        self._request = None
        self._response = None

    def getHttpService(self): return self._http_service
    def getRequest(self): return self._request
    def getResponse(self): return self._response

class TableSelectionListener(ListSelectionListener):
    def __init__(self, extender):
        self.extender = extender
        
    def valueChanged(self, event):
        if not event.getValueIsAdjusting():
            view_row = self.extender.results_table.getSelectedRow()
            if view_row != -1:
                model_row = self.extender.results_table.convertRowIndexToModel(view_row)
                
                if model_row < len(self.extender.displayed_records):
                    record = self.extender.displayed_records[model_row]
                    
                    self.extender.controller._http_service = record['http_service']
                    self.extender.controller._request = record['orig_req_bytes']
                    self.extender.controller._response = record['orig_resp_bytes']
                    
                    self.extender.orig_req_viewer.setMessage(record['orig_req_bytes'], True)
                    if record['orig_resp_bytes']:
                        self.extender.orig_resp_viewer.setMessage(record['orig_resp_bytes'], False)
                    else:
                        self.extender.orig_resp_viewer.setMessage(self.extender._helpers.stringToBytes(""), False)
                        
                    self.extender.mod_req_viewer.setMessage(record['mod_req_bytes'], True)
                    if record['mod_resp_bytes']:
                        self.extender.mod_resp_viewer.setMessage(record['mod_resp_bytes'], False)
                    else:
                        self.extender.mod_resp_viewer.setMessage(self.extender._helpers.stringToBytes(""), False)

class SettingSaver(DocumentListener, ItemListener):
    def __init__(self, extender): self.e = extender
    def insertUpdate(self, event): self.e.save_settings()
    def removeUpdate(self, event): self.e.save_settings()
    def changedUpdate(self, event): self.e.save_settings()
    def itemStateChanged(self, event): self.e.save_settings()

class BurpExtender(IBurpExtender, ITab, IContextMenuFactory):
    
    def registerExtenderCallbacks(self, callbacks):
        self._callbacks = callbacks
        self._helpers = callbacks.getHelpers()
        
        callbacks.setExtensionName("AuthSurgical (Ultimate Pro Version)")
        
        self._stdout = PrintWriter(callbacks.getStdout(), True)
        self._stderr = PrintWriter(callbacks.getStderr(), True)
        
        self.master_history_cache = []
        self.displayed_records = []
        self.current_filter = "all"
        self.processed_signatures = set()
        
        self.init_ui()
        self.load_settings()
        self.setup_listeners()
        
        callbacks.addSuiteTab(self)
        callbacks.registerContextMenuFactory(self)
        
        self._stdout.println("AuthSurgical UI Tab and Context Menu loaded successfully via Legacy API!")

    def getTabCaption(self):
        return "AuthSurgical"

    def getUiComponent(self):
        return self.ui_panel

