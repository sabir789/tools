            self._callbacks.saveExtensionSetting("txt_idor_val", self.txt_idor_val.getText())
            self._callbacks.saveExtensionSetting("txt_tamper_method", self.txt_tamper_method.getText())
            self._callbacks.saveExtensionSetting("txt_spoof_ip", self.txt_spoof_ip.getText())
            
            self._callbacks.saveExtensionSetting("chk_drop_cookie", str(self.chk_drop_cookie.isSelected()))
            self._callbacks.saveExtensionSetting("chk_drop_auth", str(self.chk_drop_auth.isSelected()))
            self._callbacks.saveExtensionSetting("chk_json_only", str(self.chk_json_only.isSelected()))
            self._callbacks.saveExtensionSetting("chk_enable_priv_esc", str(self.chk_enable_priv_esc.isSelected()))
            self._callbacks.saveExtensionSetting("chk_enable_idor", str(self.chk_enable_idor.isSelected()))
            self._callbacks.saveExtensionSetting("chk_enable_tamper", str(self.chk_enable_tamper.isSelected()))
            self._callbacks.saveExtensionSetting("chk_enable_mass_assign", str(self.chk_enable_mass_assign.isSelected()))
            self._callbacks.saveExtensionSetting("chk_enable_rest_path", str(self.chk_enable_rest_path.isSelected()))
            self._callbacks.saveExtensionSetting("chk_enable_b64_jwt", str(self.chk_enable_b64_jwt.isSelected()))
            self._callbacks.saveExtensionSetting("chk_enable_ip_spoof", str(self.chk_enable_ip_spoof.isSelected()))
