        self.chk_enable_tamper = JCheckBox("Tamper HTTP Method (e.g., POST -> PUT/PATCH)")
        self.chk_enable_mass_assign = JCheckBox("Inject Admin/Debug Params (?admin=true)")
        self.chk_enable_rest_path = JCheckBox("Enable REST Path IDOR Matching (/api/v1/user/1002)")
